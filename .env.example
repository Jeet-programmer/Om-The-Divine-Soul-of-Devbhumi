# Copy to .env (local) and set the same vars in your Vercel project settings.

# --- MongoDB (Atlas connection string) ---
DB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# --- AWS S3 (image uploads) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
BucketName=your-bucket-name

# --- Admin login ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Any long random string — invalidates existing sessions if changed
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# --- Razorpay (payments) ---
# Use rzp_test_* keys while testing; rzp_live_* for production (charges real money).
Live_API_Key=rzp_test_xxxxxxxxxxxxxx
Live_Key_Secret=your-razorpay-key-secret

# --- Google (Gmail) for confirmation emails ---
# Create an OAuth client (type: Web) in Google Cloud Console, enable the Gmail API,
# add the redirect URI below to the client's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match exactly what's registered in Google Cloud. For local dev:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google/callback
# In production set it to https://your-domain/api/admin/google/callback

# Public site URL — used for the logo image in emails (falls back to request origin).
SITE_URL=https://your-domain.com
