# Copy to .env (local) and set the same vars in your Vercel project settings.

# --- MongoDB (Atlas connection string) ---
DB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# --- AWS S3 (image uploads) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
BucketName=your-bucket-name

# --- Admin login ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Any long random string — invalidates existing sessions if changed
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
